# FastAPI Configuration
DEBUG=false
API_PORT=8000
API_HOST=0.0.0.0

# API Security
API_KEY=your-secret-api-key-here
REQUIRE_API_KEY=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60
CORS_ALLOWED_ORIGINS=["*"]

# Databases
APP_DB_URL=postgresql://app_user:app_password@localhost:5432/querypilot_app
TARGET_DB_URL=postgresql://querypilot_ro:readonly_password@localhost:5433/querypilot_target
TARGET_DB_READONLY_ROLE=querypilot_ro

# Agent Configuration
MAX_RETRIES=3
MAX_ITERATIONS=10
QUERY_TIMEOUT_SECONDS=5
RESULT_ROW_LIMIT=1000

# LLM Provider (openai, anthropic, or bedrock)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4-turbo
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# LLM API Keys (required based on provider)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# Observability & Tracing (Langfuse)
LANGFUSE_PUBLIC_KEY=pk-...
LANGFUSE_SECRET_KEY=sk-...
LANGFUSE_HOST=http://localhost:3000

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Memory Configuration
MEMORY_HISTORY_LIMIT=10
MEMORY_LONG_TERM_ENABLED=false
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_SIMILARITY_THRESHOLD=0.6
MEMORY_SUMMARY_THRESHOLD=20
